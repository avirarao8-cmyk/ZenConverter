+    /** Parses a 1-based page order such as "1,3,5-7" into page numbers. */
+    private fun parsePdfPageOrder(raw: String): List<Int> {
+        val trimmed = raw.trim().take(PdfToolOptions.MAX_PAGE_ORDER_LENGTH)
+        if (trimmed.isEmpty()) return emptyList()
+        val pages = mutableListOf<Int>()
+        trimmed.split(',').forEach { token ->
+            val part = token.trim()
+            if (part.isEmpty()) return@forEach
+            if (part.contains('-')) {
+                val bounds = part.split('-', limit = 2)
+                val start = bounds.getOrNull(0)?.trim()?.toIntOrNull()
+                val end = bounds.getOrNull(1)?.trim()?.toIntOrNull()
+                if (start != null && end != null) {
+                    if (start <= end) {
+                        for (page in start..end) pages.add(page)
+                    } else {
+                        for (page in start downTo end) pages.add(page)
+                    }
+                }
+            } else {
+                part.toIntOrNull()?.let { pages.add(it) }
+            }
+        }
+        return pages.filter { it > 0 }.take(PdfToolOptions.MAX_PAGE_ORDER_LENGTH)
+    }
