+/** Shared value across a batch, or null when the files disagree. */
+private fun <T> commonBatchValue(files: List<QueuedFile>, selector: (QueuedFile) -> T): T? {
+    if (files.isEmpty()) return null
+    val values = files.map(selector).distinct()
+    return if (values.size == 1) values.first() else null
+}
