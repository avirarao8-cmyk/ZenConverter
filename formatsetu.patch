+    // --- Image edit pipeline: resize, crop, rotate, flip, colour, blur, watermark ---
+
+    private fun applyImageEdits(source: Bitmap, edit: ImageEditOptions): Bitmap {
+        if (!edit.hasEdits) return source
+        var current: Bitmap = source
+        val intermediates = mutableListOf<Bitmap>()
+
+        fun replace(next: Bitmap?) {
+            if (next == null || next === current) return
+            if (current !== source) intermediates.add(current)
+            current = next
+        }
+
+        if (edit.crop != ImageCropMode.Off) replace(cropBitmapForMode(current, edit.crop))
+        if (edit.rotate != ImageRotateMode.None) {
+            val matrix = Matrix().apply { postRotate(rotationDegreesFor(edit.rotate).toFloat()) }
+            replace(Bitmap.createBitmap(current, 0, 0, current.width, current.height, matrix, true))
+        }
+        if (edit.flip != ImageFlipMode.None) {
+            val matrix = Matrix().apply {
+                val flipX = edit.flip == ImageFlipMode.Horizontal || edit.flip == ImageFlipMode.Both
+                val flipY = edit.flip == ImageFlipMode.Vertical || edit.flip == ImageFlipMode.Both
+                postScale(if (flipX) -1f else 1f, if (flipY) -1f else 1f)
+            }
+            replace(Bitmap.createBitmap(current, 0, 0, current.width, current.height, matrix, true))
+        }
+        resizeTargetFor(current, edit)?.let { (targetWidth, targetHeight) ->
+            replace(Bitmap.createScaledBitmap(current, targetWidth, targetHeight, true))
+        }
+        if (edit.blur != ImageBlurMode.Off) replace(blurBitmap(current, blurRadiusFor(edit.blur)))
+        if (edit.colorMode != ImageColorMode.Original) replace(applyImageColorMode(current, edit.colorMode))
+        if (!edit.watermarkText.isNullOrBlank()) replace(watermarkBitmap(current, edit))
+
+        intermediates.forEach { if (it !== current && !it.isRecycled) it.recycle() }
+        return current
+    }
+
+    private fun rotationDegreesFor(mode: ImageRotateMode): Int = when (mode) {
+        ImageRotateMode.Clockwise90 -> 90
+        ImageRotateMode.Rotate180 -> 180
+        ImageRotateMode.CounterClockwise90 -> 270
+        ImageRotateMode.None -> 0
+    }
+
+    private fun blurRadiusFor(mode: ImageBlurMode): Int = when (mode) {
+        ImageBlurMode.Light -> 4
+        ImageBlurMode.Standard -> 10
+        ImageBlurMode.Heavy -> 20
+        ImageBlurMode.Off -> 0
+    }
+
+    private fun cropBitmapForMode(source: Bitmap, mode: ImageCropMode): Bitmap {
+        val width = source.width
+        val height = source.height
+        if (width <= 0 || height <= 0) return source
+        if (mode == ImageCropMode.Circle) {
+            val side = minOf(width, height)
+            val square = Bitmap.createBitmap(source, (width - side) / 2, (height - side) / 2, side, side)
+            return circleMaskedBitmap(square)
+        }
+        val ratio = when (mode) {
+            ImageCropMode.Square -> 1.0 to 1.0
+            ImageCropMode.FourThree -> 4.0 to 3.0
+            ImageCropMode.ThreeFour -> 3.0 to 4.0
+            ImageCropMode.SixteenNine -> 16.0 to 9.0
+            ImageCropMode.NineSixteen -> 9.0 to 16.0
+            else -> return source
+        }
+        val targetAspect = ratio.first / ratio.second
+        val currentAspect = width.toDouble() / height.toDouble()
+        val cropWidth: Int
+        val cropHeight: Int
+        if (currentAspect > targetAspect) {
+            cropHeight = height
+            cropWidth = (height * targetAspect).toInt()
+        } else {
+            cropWidth = width
+            cropHeight = (width / targetAspect).toInt()
+        }
+        val safeWidth = cropWidth.coerceIn(1, width)
+        val safeHeight = cropHeight.coerceIn(1, height)
+        return Bitmap.createBitmap(
+            source,
+            ((width - safeWidth) / 2).coerceAtLeast(0),
+            ((height - safeHeight) / 2).coerceAtLeast(0),
+            safeWidth,
+            safeHeight
+        )
+    }
+
+    private fun circleMaskedBitmap(source: Bitmap): Bitmap {
+        val size = minOf(source.width, source.height)
+        val output = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(output)
+        canvas.clipPath(Path().apply { addCircle(size / 2f, size / 2f, size / 2f, Path.Direction.CW) })
+        canvas.drawBitmap(source, -((source.width - size) / 2f), -((source.height - size) / 2f), Paint(Paint.ANTI_ALIAS_FLAG))
+        return output
+    }
+
+    private fun resizeTargetFor(source: Bitmap, edit: ImageEditOptions): Pair<Int, Int>? {
+        if (edit.resizeMode == ImageResizeMode.Off) return null
+        val sourceWidth = source.width
+        val sourceHeight = source.height
+        if (sourceWidth <= 0 || sourceHeight <= 0) return null
+        return when (edit.resizeMode) {
+            ImageResizeMode.Exact -> {
+                val requestedWidth = pixelCountFor(edit.resizeWidth, edit.sizeUnit, edit.dpi)
+                val requestedHeight = pixelCountFor(edit.resizeHeight, edit.sizeUnit, edit.dpi)
+                if (edit.keepAspect) {
+                    val scale = minOf(
+                        requestedWidth.toDouble() / sourceWidth.toDouble(),
+                        requestedHeight.toDouble() / sourceHeight.toDouble()
+                    )
+                    scaleSize(sourceWidth, sourceHeight, scale)
+                } else {
+                    requestedWidth to requestedHeight
+                }
+            }
+            ImageResizeMode.Percent ->
+                scaleSize(sourceWidth, sourceHeight, edit.resizeWidth.coerceIn(1f, 1000f).toDouble() / 100.0)
+            ImageResizeMode.FitLongSide -> {
+                val limit = pixelCountFor(edit.resizeWidth, edit.sizeUnit, edit.dpi)
+                val longSide = maxOf(sourceWidth, sourceHeight)
+                if (longSide <= limit) null
+                else scaleSize(sourceWidth, sourceHeight, limit.toDouble() / longSide.toDouble())
+            }
+            ImageResizeMode.Off -> null
+        }
+    }
+
+    private fun scaleSize(width: Int, height: Int, scale: Double): Pair<Int, Int> {
+        val safeScale = scale.coerceIn(0.01, 20.0)
+        return (width * safeScale).toInt().coerceIn(1, ImageEditOptions.MAX_RESIZE_PIXELS) to
+            (height * safeScale).toInt().coerceIn(1, ImageEditOptions.MAX_RESIZE_PIXELS)
+    }
+
+    private fun pixelCountFor(value: Float, unit: ImageSizeUnit, dpi: Int): Int {
+        val safeValue = value.coerceIn(0.01f, 10_000f)
+        val safeDpi = dpi.coerceIn(36, ImageEditOptions.MAX_DPI)
+        val pixels = when (unit) {
+            ImageSizeUnit.Pixels -> safeValue
+            ImageSizeUnit.Centimeters -> safeValue / 2.54f * safeDpi
+            ImageSizeUnit.Millimeters -> safeValue / 25.4f * safeDpi
+            ImageSizeUnit.Inches -> safeValue * safeDpi
+        }
+        return pixels.toInt().coerceIn(1, ImageEditOptions.MAX_RESIZE_PIXELS)
+    }
+
+    private fun blurBitmap(source: Bitmap, radius: Int): Bitmap {
+        if (radius <= 0) return source
+        val width = source.width
+        val height = source.height
+        if (width < 3 || height < 3) return source
+        val pixels = IntArray(width * height)
+        source.getPixels(pixels, 0, width, 0, 0, width, height)
+        val buffer = IntArray(pixels.size)
+        blurPassHorizontal(pixels, buffer, width, height, radius)
+        blurPassVertical(buffer, pixels, width, height, radius)
+        val output = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+        output.setPixels(pixels, 0, width, 0, 0, width, height)
+        return output
+    }
+
+    private fun blurPassHorizontal(source: IntArray, target: IntArray, width: Int, height: Int, radius: Int) {
+        for (y in 0 until height) {
+            val rowStart = y * width
+            for (x in 0 until width) {
+                var alpha = 0
+                var red = 0
+                var green = 0
+                var blue = 0
+                var count = 0
+                val from = (x - radius).coerceAtLeast(0)
+                val to = (x + radius).coerceAtMost(width - 1)
+                for (i in from..to) {
+                    val pixel = source[rowStart + i]
+                    alpha += (pixel ushr 24) and 0xFF
+                    red += (pixel ushr 16) and 0xFF
+                    green += (pixel ushr 8) and 0xFF
+                    blue += pixel and 0xFF
+                    count += 1
+                }
+                target[rowStart + x] = ((alpha / count) shl 24) or ((red / count) shl 16) or
+                    ((green / count) shl 8) or (blue / count)
+            }
+        }
+    }
+
+    private fun blurPassVertical(source: IntArray, target: IntArray, width: Int, height: Int, radius: Int) {
+        for (x in 0 until width) {
+            for (y in 0 until height) {
+                var alpha = 0
+                var red = 0
+                var green = 0
+                var blue = 0
+                var count = 0
+                val from = (y - radius).coerceAtLeast(0)
+                val to = (y + radius).coerceAtMost(height - 1)
+                for (i in from..to) {
+                    val pixel = source[i * width + x]
+                    alpha += (pixel ushr 24) and 0xFF
+                    red += (pixel ushr 16) and 0xFF
+                    green += (pixel ushr 8) and 0xFF
+                    blue += pixel and 0xFF
+                    count += 1
+                }
+                target[y * width + x] = ((alpha / count) shl 24) or ((red / count) shl 16) or
+                    ((green / count) shl 8) or (blue / count)
+            }
+        }
+    }
+
+    private fun applyImageColorMode(source: Bitmap, mode: ImageColorMode): Bitmap {
+        val output = source.copy(Bitmap.Config.ARGB_8888, true) ?: return source
+        val width = output.width
+        val height = output.height
+        val pixels = IntArray(width * height)
+        output.getPixels(pixels, 0, width, 0, 0, width, height)
+        for (index in pixels.indices) {
+            val pixel = pixels[index]
+            val alpha = (pixel ushr 24) and 0xFF
+            val red = (pixel ushr 16) and 0xFF
+            val green = (pixel ushr 8) and 0xFF
+            val blue = pixel and 0xFF
+            pixels[index] = when (mode) {
+                ImageColorMode.Grayscale -> {
+                    val gray = (red * 299 + green * 587 + blue * 114) / 1000
+                    (alpha shl 24) or (gray shl 16) or (gray shl 8) or gray
+                }
+                ImageColorMode.Inverted ->
+                    (alpha shl 24) or ((255 - red) shl 16) or ((255 - green) shl 8) or (255 - blue)
+                ImageColorMode.Original -> pixel
+            }
+        }
+        output.setPixels(pixels, 0, width, 0, 0, width, height)
+        return output
+    }
+
+    private fun watermarkBitmap(source: Bitmap, edit: ImageEditOptions): Bitmap {
+        val text = edit.watermarkText?.trim().orEmpty()
+        if (text.isEmpty()) return source
+        val output = source.copy(Bitmap.Config.ARGB_8888, true) ?: return source
+        val shorterSide = minOf(output.width, output.height).toFloat()
+        val textSize = (shorterSide * edit.watermarkSizePercent.coerceIn(2, 30) / 100f).coerceAtLeast(10f)
+        val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            color = Color.WHITE
+            this.textSize = textSize
+            isFakeBoldText = true
+            setShadowLayer(textSize / 6f, 0f, 0f, Color.argb(170, 0, 0, 0))
+            alpha = edit.watermarkOpacity.coerceIn(5, 100) * 255 / 100
+        }
+        val metrics = paint.fontMetrics
+        val textWidth = paint.measureText(text)
+        val margin = (shorterSide * 0.04f).coerceAtLeast(8f)
+        val position = edit.watermarkPosition.coerceIn(1, 9)
+        val column = (position - 1) % 3
+        val row = (position - 1) / 3
+        val x = when (column) {
+            0 -> margin
+            1 -> (output.width - textWidth) / 2f
+            else -> output.width - textWidth - margin
+        }
+        val y = when (row) {
+            0 -> margin - metrics.ascent
+            1 -> output.height / 2f - (metrics.ascent + metrics.descent) / 2f
+            else -> output.height - margin - metrics.descent
+        }
+        Canvas(output).drawText(
+            text,
+            x.coerceIn(0f, (output.width - textWidth).coerceAtLeast(0f)),
+            y.coerceIn(textSize, output.height.toFloat()),
+            paint
+        )
+        return output
+    }
