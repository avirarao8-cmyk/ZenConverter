+    private fun writeWatermarkedPdf(input: ConversionTaskInput, outputFile: File) {
+        val tool = input.pdfOptions.tool
+        val text = tool.watermarkText?.trim().orEmpty()
+        if (text.isEmpty()) throw LocalizedFailure(localizedText(R.string.text_task_message_pdf_conversion_failed))
+        forEachPdfPage(input, outputFile) { document ->
+            val font = PDType1Font.HELVETICA_BOLD
+            val alpha = tool.watermarkOpacity.coerceIn(5, 100) / 100f
+            val angle = Math.toRadians(tool.watermarkRotation.coerceIn(0, 90).toDouble())
+            val pageCount = document.numberOfPages
+            for (pageIndex in 0 until pageCount) {
+                val page = document.getPage(pageIndex)
+                val box = page.cropBox
+                val fontSize = (minOf(box.width, box.height) * 0.12f).coerceIn(12f, 96f)
+                val textWidth = font.getStringWidth(text) / 1000f * fontSize
+                val state = PDExtendedGraphicsState().apply {
+                    nonStrokingAlphaConstant = alpha
+                }
+                PDPageContentStream(document, page, PDPageContentStream.AppendMode.APPEND, true, true).use { stream ->
+                    stream.setGraphicsStateParameters(state)
+                    stream.beginText()
+                    stream.setFont(font, fontSize)
+                    stream.setNonStrokingColor(120, 120, 120)
+                    val x = box.lowerLeftX + (box.width - (textWidth * Math.cos(angle).toFloat())) / 2f
+                    val y = box.lowerLeftY + (box.height - (textWidth * Math.sin(angle).toFloat())) / 2f
+                    stream.setTextMatrix(com.tom_roush.pdfbox.util.Matrix.getRotateInstance(angle, x, y))
+                    stream.showText(text)
+                    stream.endText()
+                }
+                updateImageProgress(progressForIndexedWork(pageIndex, pageCount, 0.05f, 0.85f))
+            }
+        }
+    }
