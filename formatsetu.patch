+    private fun writeCroppedPdf(input: ConversionTaskInput, outputFile: File) {
+        val marginPercent = input.pdfOptions.tool.cropMarginPercent.coerceIn(0, 40)
+        forEachPdfPage(input, outputFile) { document ->
+            val pageCount = document.numberOfPages
+            for (pageIndex in 0 until pageCount) {
+                val page = document.getPage(pageIndex)
+                val box = page.cropBox
+                val insetX = box.width * marginPercent / 100f
+                val insetY = box.height * marginPercent / 100f
+                val newWidth = (box.width - insetX * 2f).coerceAtLeast(1f)
+                val newHeight = (box.height - insetY * 2f).coerceAtLeast(1f)
+                page.cropBox = PDRectangle(box.lowerLeftX + insetX, box.lowerLeftY + insetY, newWidth, newHeight)
+                updateImageProgress(progressForIndexedWork(pageIndex, pageCount, 0.05f, 0.85f))
+            }
+        }
+    }
