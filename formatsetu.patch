+    private fun writePdfWithPageNumbers(input: ConversionTaskInput, outputFile: File) {
+        val tool = input.pdfOptions.tool
+        val startNumber = tool.pageNumberStart.coerceAtLeast(1)
+        forEachPdfPage(input, outputFile) { document ->
+            val font = PDType1Font.HELVETICA
+            val fontSize = 11f
+            val margin = 24f
+            val pageCount = document.numberOfPages
+            for (pageIndex in 0 until pageCount) {
+                val page = document.getPage(pageIndex)
+                val label = (startNumber + pageIndex).toString()
+                val box = page.cropBox
+                val textWidth = font.getStringWidth(label) / 1000f * fontSize
+                val x = when (tool.pageNumberPosition) {
+                    PdfPageNumberPosition.BottomLeft, PdfPageNumberPosition.TopLeft -> box.lowerLeftX + margin
+                    PdfPageNumberPosition.BottomRight, PdfPageNumberPosition.TopRight ->
+                        box.upperRightX - margin - textWidth
+                    else -> box.lowerLeftX + (box.width - textWidth) / 2f
+                }
+                val y = when (tool.pageNumberPosition) {
+                    PdfPageNumberPosition.TopLeft,
+                    PdfPageNumberPosition.TopCentre,
+                    PdfPageNumberPosition.TopRight -> box.upperRightY - margin
+                    else -> box.lowerLeftY + margin
+                }
+                PDPageContentStream(document, page, PDPageContentStream.AppendMode.APPEND, true, true).use { stream ->
+                    stream.beginText()
+                    stream.setFont(font, fontSize)
+                    stream.setNonStrokingColor(70, 70, 70)
+                    stream.setTextMatrix(com.tom_roush.pdfbox.util.Matrix.getTranslateInstance(x, y))
+                    stream.showText(label)
+                    stream.endText()
+                }
+                updateImageProgress(progressForIndexedWork(pageIndex, pageCount, 0.05f, 0.85f))
+            }
+        }
+    }
