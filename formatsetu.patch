+/**
+ * Derives the bitrate needed to keep an output at or below [targetSizeBytes] for the
+ * given duration. Returns null when no target is set or the duration is unknown.
+ */
+fun targetBitrateForSize(targetSizeBytes: Long?, durationMs: Long?): Int? {
+    if (targetSizeBytes == null || targetSizeBytes <= 0L) return null
+    val duration = durationMs?.takeIf { it > 0L } ?: return null
+    val bitsPerSecond = (targetSizeBytes.toDouble() * 8.0) / (duration.toDouble() / 1000.0)
+    if (!bitsPerSecond.isFinite() || bitsPerSecond <= 0.0) return null
+    return bitsPerSecond.toLong().coerceAtMost(Int.MAX_VALUE.toLong()).toInt()
