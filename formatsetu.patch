+    private fun writeOrganizedPdf(input: ConversionTaskInput, outputFile: File) {
+        val order = parsePdfPageOrder(input.pdfOptions.tool.pageOrder)
+        if (order.isEmpty()) throw LocalizedFailure(localizedText(R.string.text_task_message_pdf_conversion_failed))
+
+        val inputUris = input.inputUris.ifEmpty { listOf(input.inputUri) }
+        if (inputUris.size != 1) throw LocalizedFailure(localizedText(R.string.text_task_message_pdf_conversion_failed))
+
+        throwIfConversionCancelled()
+        ensurePdfBoxReady()
+        val cachedInputs = cachePdfInputsForPdfBox(input, inputUris)
+        val source = loadPdfBoxDocument(cachedInputs.files.first(), input.pdfPasswordAt(0))
+        val destination = PDDocument(MemoryUsageSetting.setupTempFileOnly())
+        try {
+            if (source.numberOfPages <= 0) {
+                throw LocalizedFailure(localizedText(R.string.text_task_message_pdf_has_no_pages))
+            }
+            order.forEachIndexed { index, pageNumber ->
+                throwIfConversionCancelled()
+                val pageIndex = pageNumber - 1
+                if (pageIndex in 0 until source.numberOfPages) {
+                    destination.importPage(source.getPage(pageIndex))
+                }
+                updateImageProgress(progressForIndexedWork(index, order.size, 0.05f, 0.85f))
+            }
+            if (destination.numberOfPages <= 0) {
+                throw LocalizedFailure(localizedText(R.string.text_task_message_pdf_conversion_failed))
+            }
+            throwIfConversionCancelled()
+            destination.save(outputFile)
+            throwIfConversionCancelled()
+            updateImageProgress(0.95f)
+        } catch (throwable: Throwable) {
+            outputFile.delete()
+            throw throwable
+        } finally {
+            runCatching { destination.close() }
+            runCatching { source.close() }
+            cachedInputs.delete()
+        }
+    }
