+private const val TARGET_SIZE_KB = "KB"
+private const val TARGET_SIZE_MB = "MB"
+private const val TARGET_SIZE_BYTES_PER_KB = 1024L
+private const val TARGET_SIZE_BYTES_PER_MB = 1024L * 1024L
+
+private fun targetSizeTextFor(bytes: Long?): String {
+    if (bytes == null || bytes <= 0L) return ""
+    return if (bytes >= TARGET_SIZE_BYTES_PER_MB) {
+        val megabytes = bytes.toDouble() / TARGET_SIZE_BYTES_PER_MB.toDouble()
+        "${formatTargetSizeNumber(megabytes)} $TARGET_SIZE_MB"
+    } else {
+        val kilobytes = bytes.toDouble() / TARGET_SIZE_BYTES_PER_KB.toDouble()
+        "${formatTargetSizeNumber(kilobytes)} $TARGET_SIZE_KB"
+    }
+}
+
+private fun formatTargetSizeNumber(value: Double): String {
+    if (value == value.toLong().toDouble()) return value.toLong().toString()
+    return java.math.BigDecimal(value)
+        .setScale(2, java.math.RoundingMode.HALF_UP)
+        .stripTrailingZeros()
+        .toPlainString()
+}
+
+private fun parseTargetSizeInput(raw: String): Long? {
+    val trimmed = raw.trim()
+    if (trimmed.isEmpty()) return null
+    val lower = trimmed.lowercase(Locale.US)
+    val multiplier = when {
+        lower.endsWith("mb") -> TARGET_SIZE_BYTES_PER_MB
+        lower.endsWith("kb") -> TARGET_SIZE_BYTES_PER_KB
+        else -> TARGET_SIZE_BYTES_PER_KB
+    }
+    val numberText = lower.removeSuffix("mb").removeSuffix("kb").trim()
+    val number = numberText.toDoubleOrNull() ?: return null
+    if (number <= 0.0) return null
+    return (number * multiplier.toDouble()).toLong().takeIf { it > 0L }
+}
+
+@Composable
+private fun TargetSizeField(
+    valueBytes: Long?,
+    label: String,
+    hint: String,
+    onValueChange: (Long?) -> Unit,
+    modifier: Modifier = Modifier
+) {
+    var text by remember { mutableStateOf(targetSizeTextFor(valueBytes)) }
+    var focused by remember { mutableStateOf(false) }
+    LaunchedEffect(valueBytes) {
+        if (!focused) text = targetSizeTextFor(valueBytes)
+    }
+    Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {
+        OutlinedTextField(
+            value = text,
+            onValueChange = { rawValue ->
+                val cleaned = rawValue.take(16)
+                text = cleaned
+                onValueChange(if (cleaned.isBlank()) null else parseTargetSizeInput(cleaned))
+            },
+            singleLine = true,
+            label = { Text(label) },
+            placeholder = { Text("0") },
+            keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Decimal),
+            colors = OutlinedTextFieldDefaults.colors(
+                focusedBorderColor = MaterialTheme.colorScheme.primary,
+                unfocusedBorderColor = MaterialTheme.colorScheme.outline,
+                focusedLabelColor = MaterialTheme.colorScheme.primary,
+                unfocusedLabelColor = MaterialTheme.colorScheme.onSurfaceVariant,
+                cursorColor = MaterialTheme.colorScheme.primary,
+                focusedContainerColor = MaterialTheme.colorScheme.surface,
+                unfocusedContainerColor = MaterialTheme.colorScheme.surface
+            ),
+            modifier = modifier
+                .fillMaxWidth()
+                .onFocusChanged { focusState ->
+                    if (focused && !focusState.isFocused) text = targetSizeTextFor(valueBytes)
+                    focused = focusState.isFocused
+                }
+        )
+        Text(
+            text = hint,
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            maxLines = 2,
+            overflow = TextOverflow.Ellipsis
+        )
+    }
+}
+
 @Composable
