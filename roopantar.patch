+    /**
+     * Writes [bitmap] to [outputFile], honouring an optional maximum output size.
+     * Lossy formats search for the highest quality that fits; lossless formats
+     * progressively downscale until the encoded result fits.
+     */
+    private fun writeCompressedImage(
+        bitmap: Bitmap,
+        outputFile: File,
+        compressFormat: Bitmap.CompressFormat,
+        maxQuality: Int,
+        useWebpLossless: Boolean,
+        targetSizeBytes: Long?
+    ) {
+        val isLossless = compressFormat == Bitmap.CompressFormat.PNG || useWebpLossless
+        if (targetSizeBytes == null || targetSizeBytes <= 0L) {
+            writeImageBytes(outputFile, compressBitmapToBytes(bitmap, compressFormat, maxQuality))
+            return
+        }
+        if (!isLossless) {
+            val cappedQuality = maxQuality.coerceIn(1, 100)
+            val bestEffort = compressBitmapToBytes(bitmap, compressFormat, cappedQuality)
+            if (bestEffort.size.toLong() <= targetSizeBytes) {
+                writeImageBytes(outputFile, bestEffort)
+                return
+            }
+            var low = 1
+            var high = cappedQuality - 1
+            var chosen: ByteArray? = null
+            while (low <= high) {
+                val mid = (low + high) / 2
+                val candidate = compressBitmapToBytes(bitmap, compressFormat, mid)
+                if (candidate.size.toLong() <= targetSizeBytes) {
+                    chosen = candidate
+                    low = mid + 1
+                } else {
+                    high = mid - 1
+                }
+            }
+            writeImageBytes(outputFile, chosen ?: compressBitmapToBytes(bitmap, compressFormat, 1))
+            return
+        }
+        var scale = 1.0
+        var bytes = compressBitmapToBytes(bitmap, compressFormat, 100)
+        var attempts = 0
+        while (bytes.size.toLong() > targetSizeBytes && scale > 0.2 && attempts < 12) {
+            scale *= 0.85
+            val scaledWidth = (bitmap.width * scale).toInt().coerceAtLeast(1)
+            val scaledHeight = (bitmap.height * scale).toInt().coerceAtLeast(1)
+            val scaled = Bitmap.createScaledBitmap(bitmap, scaledWidth, scaledHeight, true)
+            bytes = compressBitmapToBytes(scaled, compressFormat, 100)
+            scaled.recycle()
+            attempts += 1
+        }
+        writeImageBytes(outputFile, bytes)
+    }
+
+    private fun compressBitmapToBytes(
+        bitmap: Bitmap,
+        compressFormat: Bitmap.CompressFormat,
+        quality: Int
+    ): ByteArray {
+        return ByteArrayOutputStream().use { output ->
+            if (!bitmap.compress(compressFormat, quality.coerceIn(1, 100), output)) {
+                throw LocalizedFailure(localizedText(R.string.text_task_message_image_engine_could_not_write_this_output))
+            }
+            output.toByteArray()
+        }
+    }
+
+    private fun writeImageBytes(outputFile: File, bytes: ByteArray) {
+        outputFile.outputStream().use { output ->
+            output.write(bytes)
+            output.flush()
+        }
+    }
